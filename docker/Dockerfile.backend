FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY backend/src/Gestio.Api/Gestio.Api.csproj backend/src/Gestio.Api/
RUN dotnet restore backend/src/Gestio.Api/Gestio.Api.csproj
COPY backend/src/Gestio.Api/ backend/src/Gestio.Api/
RUN dotnet publish backend/src/Gestio.Api/Gestio.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Gestio.Api.dll"]
